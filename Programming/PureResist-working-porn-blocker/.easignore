# Ignore node_modules — EAS runs npm install on the server
node_modules/

# Ignore git files
.git/
.gitignore

# Ignore build artifacts (keeps archive small, avoids upload timeouts)
android/app/build
android/build
android/.gradle
ios/build
ios/Pods
ios/*.xcworkspace
.expo/

# Ignore development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env*
!.env.example

# Ignore backend code (not needed for the app build)
backend/

# Ignore docs and assets not needed for build
docs/
assets/raw/
**/*.psd
**/*.ai 