# Ignore node_modules except for specific iOS dependencies
node_modules/**/*
!node_modules/@lottiefiles/dotlottie-react-native/ios/**/*
!node_modules/react-native-purchases/ios/**/*

# Ignore git files
.git
.gitignore

# Ignore build artifacts
android/app/build
ios/build
ios/Pods

# Ignore development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env*
!.env.example

# Ignore backend code (not needed for the app build)
backend/

# Ignore docs and assets not needed for build
docs/
assets/raw/
**/*.psd
**/*.ai 